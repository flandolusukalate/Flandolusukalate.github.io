{
  "name": "flandolu-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 0.0.0.0",
    "check": "node scripts/check-content.mjs && astro check",
    "editor": "node scripts/editor.mjs --open",
    "test": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.13",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.4.5",
    "lucide-astro": "^0.556.0",
    "pagefind": "^1.4.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  }
}

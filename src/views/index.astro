---
import { localeFromPath, localizedPath, translator } from "../lib/i18n";

const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
import { ArrowRight, Feather } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import StudyOpening from '../components/StudyOpening.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects, getMoments } from '../lib/content';
const [posts, projects, moments] = await Promise.all([getPosts(locale), getProjects(locale), getMoments(locale)]);
---
<BaseLayout>
  <StudyOpening />

  <section class="home-notebook section" id="latest-posts" aria-labelledby="latest-posts-title">
    <div class="container">
      <div class="section-top">
        <div><span class="section-eyebrow">From my notebook</span><h2 class="section-title" id="latest-posts-title">Latest Posts</h2><p class="section-subtitle">{t("最近写下的技术笔记与灵感。")}</p></div>
        <a class="more-link" href={localizedPath("/blog/", locale)}>{t("全部文章")} <ArrowRight size={17}/></a>
      </div>
      <div class="posts-grid">
        {posts.slice(0, 3).map(post => <PostCard post={post}/>)}
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-top">
      <div><span class="section-eyebrow">Things I am making</span><h2 class="section-title">Featured Projects</h2><p class="section-subtitle">{t("从一个小想法，到慢慢成形的作品。")}</p></div>
      <a class="more-link" href={localizedPath("/projects/", locale)}>{t("查看项目")} <ArrowRight size={17}/></a>
    </div>
    <div class="projects-grid">
      {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} index={index}/>)}
    </div>
  </section>

  <section class="container section">
    <div class="section-top">
      <div><span class="section-eyebrow">Small moments</span><h2 class="section-title">Fragments of Life</h2><p class="section-subtitle">{t("写代码之外，也要记得抬头看天空。")}</p></div>
      <a class="more-link" href={localizedPath("/moments/", locale)}>{t("更多动态")} <ArrowRight size={17}/></a>
    </div>
    <div class="home-intro">
      <div class="intro-card">
        <span class="section-eyebrow"><Feather size={14} style="display:inline"/> A note from me</span>
        <h3>{t("一间属于自己的数字书房。")}</h3>
        <p>{t("这里并非只有完成的作品，也有进行中的实验、踩过的坑、突然冒出的灵感，以及普通日子里微小却真实的快乐。")}</p>
        <a class="more-link" href={localizedPath("/about/", locale)}>{t("认识我")} <ArrowRight size={16}/></a>
      </div>
      <div class="intro-card">
        <span class="section-eyebrow">This space</span>
        <div class="mini-stats">
          <div><strong>{posts.length}</strong><span>{t("篇文章")}</span></div>
          <div><strong>{projects.length}</strong><span>{t("个项目")}</span></div>
          <div><strong>{moments.length}</strong><span>{t("条动态")}</span></div>
        </div>
        <div class="star-divider">✦</div>
        <p>{t("在代码与幻想之间，记录属于自己的世界。")}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-notebook {
    position: relative;
    z-index: 1;
    padding-top: 56px;
    border-radius: 28px 28px 0 0;
    background: var(--bg);
    scroll-margin-top: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Astro may insert the component's module script between these two sections. */
    :global(study-opening[data-motion='full']) ~ .home-notebook { margin-top: -68px; }
  }
  @media (max-width: 600px) {
    .home-notebook { padding-top: 40px; border-radius: 20px 20px 0 0; }
  }
</style>

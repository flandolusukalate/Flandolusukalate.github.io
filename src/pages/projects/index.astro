---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';
const projects = await getProjects();
---
<BaseLayout title="Projects · 项目" description="Flandolu 的个人项目、开发实验和开源创作。">
  <section class="page-hero">
    <div class="container page-hero-content">
      <span class="section-eyebrow">Build · Explore · Create</span>
      <h1>Projects</h1>
      <p>收集奇思妙想、开发过程和不断探索的作品。部分项目还处于规划或实验阶段。</p>
    </div>
  </section>
  <section class="container section">
    <div class="section-top">
      <div><span class="section-eyebrow">My little laboratory</span><h2 class="section-title">Selected Works</h2></div>
    </div>
    <div class="filter-list" style="margin-bottom:25px">
      <button class="filter-chip active" data-project-filter="all">全部</button>
      <button class="filter-chip" data-project-filter="developing">开发中</button>
      <button class="filter-chip" data-project-filter="planned">构思中</button>
      <button class="filter-chip" data-project-filter="released">已发布</button>
    </div>
    <div class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} index={index}/>)}</div>
    <div class="empty-state" id="project-empty" hidden><strong>还没有这一类项目 ✦</strong>换个状态看看。</div>
  </section>
  <script>
    const initProjectFilters = () => {
      const chips = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]');
      if (!chips.length || chips[0].dataset.bound === 'true') return;
      chips[0].dataset.bound = 'true';
      const cards = document.querySelectorAll<HTMLElement>('[data-status]');
      const empty = document.querySelector<HTMLElement>('#project-empty');
      chips.forEach(chip => chip.addEventListener('click', () => {
        const target = chip.dataset.projectFilter;
        chips.forEach(b => b.classList.toggle('active', b === chip));
        let count = 0;
        cards.forEach(card => { card.hidden = target !== 'all' && card.dataset.status !== target; if (!card.hidden) count++; });
        if (empty) empty.hidden = count !== 0;
      }));
    };
    document.addEventListener('astro:page-load', initProjectFilters);
    initProjectFilters();
  </script>
</BaseLayout>

---
import { ArrowRight, BookOpen, Sparkles, Code2, Feather } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts, getProjects, getMoments } from '../lib/content';
const [posts, projects, moments] = await Promise.all([getPosts(), getProjects(), getMoments()]);
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art"><img src="/illustrations/dragon-library-hero.webp" alt="" fetchpriority="high" /></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow-badge"><Sparkles size={14}/> Welcome to my little world</span>
        <h1 class="hero-title" id="hero-title">Hello, I'm <span>Flandolu.</span></h1>
        <p class="hero-subtitle serif">Code, stories &amp; imagination</p>
        <p class="hero-description">你好，欢迎来到我的数字书房。这里收藏着代码、灵感、正在进行的创作，以及那些值得记录的小小瞬间。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/blog/"><BookOpen size={18}/> 探索博客 <ArrowRight size={17}/></a>
          <a class="btn btn-secondary" href="/projects/"><Code2 size={18}/> 我的作品</a>
        </div>
      </div>
    </div>
    <span class="hero-scroll">Scroll to explore</span>
  </section>

  <section class="container section">
    <div class="section-top">
      <div><span class="section-eyebrow">From my notebook</span><h2 class="section-title">Latest Posts</h2><p class="section-subtitle">最近写下的技术笔记与灵感。</p></div>
      <a class="more-link" href="/blog/">全部文章 <ArrowRight size={17}/></a>
    </div>
    <div class="posts-grid">
      {posts.slice(0, 3).map(post => <PostCard post={post}/>)}
    </div>
  </section>

  <section class="container section">
    <div class="section-top">
      <div><span class="section-eyebrow">Things I am making</span><h2 class="section-title">Featured Projects</h2><p class="section-subtitle">从一个小想法，到慢慢成形的作品。</p></div>
      <a class="more-link" href="/projects/">查看项目 <ArrowRight size={17}/></a>
    </div>
    <div class="projects-grid">
      {projects.slice(0, 3).map((project, index) => <ProjectCard project={project} index={index}/>)}
    </div>
  </section>

  <section class="container section">
    <div class="section-top">
      <div><span class="section-eyebrow">Small moments</span><h2 class="section-title">Fragments of Life</h2><p class="section-subtitle">写代码之外，也要记得抬头看天空。</p></div>
      <a class="more-link" href="/moments/">更多动态 <ArrowRight size={17}/></a>
    </div>
    <div class="home-intro">
      <div class="intro-card">
        <span class="section-eyebrow"><Feather size={14} style="display:inline"/> A note from me</span>
        <h3>一间属于自己的数字书房。</h3>
        <p>这里并非只有完成的作品，也有进行中的实验、踩过的坑、突然冒出的灵感，以及普通日子里微小却真实的快乐。</p>
        <a class="more-link" href="/about/">认识我 <ArrowRight size={16}/></a>
      </div>
      <div class="intro-card">
        <span class="section-eyebrow">This space</span>
        <div class="mini-stats">
          <div><strong>{posts.length}</strong><span>篇文章</span></div>
          <div><strong>{projects.length}</strong><span>个项目</span></div>
          <div><strong>{moments.length}</strong><span>条动态</span></div>
        </div>
        <div class="star-divider">✦</div>
        <p>在代码与幻想之间，记录属于自己的世界。</p>
      </div>
    </div>
  </section>
</BaseLayout>
